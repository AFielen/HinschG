# Datenbank
# DB_PASSWORD wird von docker-compose für den Postgres-Container UND die DATABASE_URL genutzt
DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://drk:${DB_PASSWORD}@db:5432/hinweisgebersystem

# JWT
JWT_SECRET=your-secret-key-min-32-chars

# Setup
# Einmaliger Setup-Schutz für /api/admin/seed
SETUP_TOKEN=your-setup-token

# Verschlüsselung
# 32-Byte-Schlüssel base64, Erzeugung: openssl rand -base64 32
ENCRYPTION_KEY=your-base64-encryption-key

# E-Mail (Mailjet – EU, DSGVO-konform)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAIL_FROM=noreply@drk-aachen.de

# App
NEXT_PUBLIC_APP_URL=https://hinweisgebersystem.drk-aachen.de

# Datei-Uploads
# Ablageverzeichnis für Anhänge (Default: ./uploads).
# Im Docker-Setup setzt docker-compose.yml UPLOAD_DIR=/app/uploads (benanntes Volume).
UPLOAD_DIR=./uploads
